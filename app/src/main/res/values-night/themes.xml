<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SplitReader" parent="android:Theme.Material.NoActionBar">
        <!-- Dark window background before Compose draws (matches NightBg). -->
        <item name="android:windowBackground">@color/window_bg_night</item>
        <!-- Launch-window bars; see values/themes.xml. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
